# 本机 GitHub 不可直连(CLAUDE.md M2 注意),Electron 二进制走 npmmirror。
# 三行键:registry 换 npm 镜像;electron_mirror 供 electron 的 install.js(@electron/get)读取;
# electron_builder_binaries_mirror 供 M4 打包(winCodeSign/nsis)用。
registry=https://registry.npmmirror.com
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
