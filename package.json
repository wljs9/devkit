{
  "name": "devkit",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 开发环境管理器:国内镜像下载 + 可携化安装 + 干净环境变量",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "m0": "node scripts/m0-probe.ts",
    "m0:quick": "node scripts/m0-probe.ts --quick",
    "env-selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/env-selftest.ps1"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "semver": "^7.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.5.8",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
