{
  "name": "devkit",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 开发环境管理器:国内镜像下载 + 可携化安装 + 干净环境变量",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "bin:electron": "node scripts/fetch-electron.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "m0": "node scripts/m0-probe.ts",
    "m0:quick": "node scripts/m0-probe.ts --quick",
    "env-selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/env-selftest.ps1"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "extract-zip": "^2.0.1",
    "naive-ui": "^2.45.0",
    "pinia": "^3.0.3",
    "semver": "^7.6.3",
    "undici": "^8.10.2",
    "vue": "^3.5.11",
    "vue-router": "^4.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.5.8",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
